  "rules": {
    "do": [
      "Button: Use one primary button per view, for the main action.",
      "Button: Label with a verb in sentence case: “Save changes”, not “OK”.",
      "Button: Match sizes in a row — buttons and inputs share the 32 / 40 / 48 heights.",
      "Button: Put the primary action last in a group, after Cancel.",
      "Button icon: Always give it an accessible name (`aria-label`) and a tooltip.",
      "Button icon: Use Tertiary in toolbars, cards and table rows.",
      "Use `lg`/`xl` on marketing pages, `md` in product UI, `sm`/`xs` in tables and toolbars."
    ],
    "dont": [],
    "forbidden": [
      "Button: Never put two primary buttons in one view.",
      "Button: Never use the Link style for destructive actions.",
      "Button: Never detach to change an icon — use Leading / Trailing icon swap.",
      "Button: Never use a button to navigate to another page — use a link.",
      "Button icon: Never use an icon-only button for the main action of a view.",
      "Button icon: Never use an icon whose meaning is not widely understood without a label."
    ]
  },
