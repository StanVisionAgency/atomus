  "rules": {
    "do": [
      "Pick the colour by meaning: Success, Warning, Error, Brand (info), Gray (neutral).",
      "Keep labels to one or two words.",
      "Use Tag, not Badge, for values the user can remove."
    ],
    "dont": [
      "Don't use solid **warning** with small text — white on amber is 2.2:1. Prefer the light warning badge.",
      "Don't use badges as buttons; for removable values use Tag."
    ],
    "forbidden": [
      "Never use a badge as a button or link.",
      "Never rely on colour alone — the word carries the meaning.",
      "Never place more than three badges together."
    ]
  },
  "examples": [
    {
      "title": "Usage",
      "code": "import { Badge, Tag } from '@stanvision/atomus-react';\n\n<Badge color=\"success\" dot>Active</Badge>\n<Badge color=\"brand\" variant=\"solid\">New</Badge>\n<Tag onRemove={() => remove(id)}>Figma</Tag>",
