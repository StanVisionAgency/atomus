  "rules": {
    "do": [
      "Card: Put any content into the Content slot.",
      "Card: Use the Header and Footer booleans instead of building your own.",
      "Card: Use Outlined on white backgrounds and Filled on grey ones."
    ],
    "dont": [
      "Don't nest cards; use dividers or a filled card instead.",
      "Don't add a coloured left border to signal status — use Alert or Badge."
    ],
    "forbidden": [
      "Card: Never nest cards inside cards.",
      "Card: Never add shadows by hand — pick the Elevated style.",
      "Card: Never detach to change padding — use the Padding variant."
    ]
  },
