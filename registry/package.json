{
  "name": "atomus-registry",
  "private": true,
  "type": "module",
  "description": "shadcn registry for Atomus — generated from react/src, css/atomus.css and the docs website sections.",
  "license": "MIT",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "test:install": "node scripts/test-install.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "postcss": "8.5.29",
    "react": "^18.3.1",
    "shadcn": "4.21.4",
    "typescript": "^5.5.0"
  }
}
