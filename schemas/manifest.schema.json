{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.atomus.io/schemas/manifest.schema.json",
  "title": "Atomus manifest",
  "description": "The whole Atomus design system as data: components (see component.schema.json) and tokens. Generated by scripts/build-manifest.mjs into packages/manifest/atomus.manifest.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "package", "generatedFrom", "docs", "exports", "components", "tokens"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "const": "Atomus" },
    "version": { "type": "string", "description": "Version of @stanvision/atomus-react the manifest describes." },
    "package": { "const": "@stanvision/atomus-react" },
    "tokensPackage": { "const": "@stanvision/atomus-tokens" },
    "generatedFrom": { "type": "array", "items": { "type": "string" } },
    "docs": { "type": "string", "pattern": "^https://docs\\.atomus\\.io/" },
    "exports": {
      "type": "object",
      "description": "Everything @stanvision/atomus-react exports: values (components, hooks) and types.",
      "additionalProperties": false,
      "required": ["values", "types"],
      "properties": {
        "values": { "type": "array", "items": { "type": "string" } },
        "types": { "type": "array", "items": { "type": "string" } }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "component.schema.json" }
    },
    "tokens": { "$ref": "#/$defs/tokens" }
  },
  "$defs": {
    "colorToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "group", "light", "dark", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^--color-" },
        "group": { "type": "string" },
        "light": { "type": "string" },
        "dark": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "tailwind": { "type": "array", "items": { "type": "string" } },
        "figma": { "type": ["string", "null"] }
      }
    },
    "modeToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string", "pattern": "^--" },
        "values": { "type": "object", "additionalProperties": { "type": "string" } },
        "description": { "type": "string" },
        "tailwind": { "type": "array", "items": { "type": "string" } },
        "figma": { "type": ["string", "null"] }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "intents", "groups", "semantic", "spacing", "radius", "shadows", "textStyles", "primitives"],
      "properties": {
        "rules": { "type": "array", "items": { "type": "string" } },
        "intents": {
          "type": "array",
          "description": "The tokens to reach for first, by intent.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intent", "tokens"],
            "properties": {
              "intent": { "type": "string" },
              "tokens": { "type": "array", "items": { "type": "string", "pattern": "^--" } }
            }
          }
        },
        "groups": {
          "type": "object",
          "description": "Colour groups (text, background, border …) with the intent of each.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "intent"],
            "properties": { "title": { "type": "string" }, "intent": { "type": "string" } }
          }
        },
        "semantic": { "type": "array", "items": { "$ref": "#/$defs/colorToken" } },
        "spacing": { "type": "array", "items": { "$ref": "#/$defs/modeToken" } },
        "radius": { "type": "array", "items": { "$ref": "#/$defs/modeToken" } },
        "shadows": { "type": "array", "items": { "$ref": "#/$defs/modeToken" } },
        "textStyles": { "type": "array", "items": { "type": "string" } },
        "primitives": {
          "type": "object",
          "description": "Primitive colour tokens → value. Never use these directly; alias them from a semantic token.",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
