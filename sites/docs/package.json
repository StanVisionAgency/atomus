{
  "name": "atomus-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && npm run registry && npm run storybook && astro build && node scripts/llms.mjs",
    "build:site": "npm run sync && astro build && node scripts/llms.mjs",
    "registry": "npm --prefix ../../registry install --no-audit --no-fund && npm --prefix ../../registry run build",
    "storybook": "npm --prefix ../../react install --no-audit --no-fund && npm --prefix ../../react run build-storybook:docs",
    "preview": "astro preview",
    "llms": "node scripts/llms.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/starlight": "0.42.3",
    "astro": "7.3.4",
    "hast-util-select": "6.0.4",
    "hast-util-to-string": "3.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "sharp": "^0.34.0",
    "unified": "11.0.5"
  }
}
