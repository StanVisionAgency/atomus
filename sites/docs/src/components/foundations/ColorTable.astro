---
// Semantic colour tokens with a real swatch for the Light and Dark value.
// Rows come from the Markdown table in guidelines/foundations/color.md (via scripts/sync.mjs).
import CopyToken from './CopyToken.astro';
import { ramp } from '../../lib/tokens';
interface Row { token: string; figma?: string; light: string; dark: string }
interface Props { rows: Row[] }
const { rows } = Astro.props;
const kindOf = (t: string) => (/^--color-(text|fg)-/.test(t) ? 'text' : /^--color-border-/.test(t) ? 'border' : 'fill');
// "On" colours are shown on the surface they are meant for, not on the page background.
const hex = (name: string, step: string) => ramp(name).steps.find((s) => s.step === step)?.hex ?? '#000';
const backdrop = (t: string, mode: 'light' | 'dark') => {
  if (/-(on-brand|white)$/.test(t)) return hex('brand', '600');
  if (/-on-warning$/.test(t)) return hex('amber', '500');
  if (/-inverse$/.test(t)) return mode === 'light' ? hex('gray', '900') : '#ffffff';
  return undefined;
};
const isAlpha = (h: string) => /^#[0-9a-f]{8}$/i.test(h) && !/ff$/i.test(h);
---
<div class="fd-table-wrap not-content">
  <table class="fd-color-table">
    <thead><tr><th scope="col">Token</th><th scope="col">Light</th><th scope="col">Dark</th></tr></thead>
    <tbody>
      {rows.map((r) => {
        const kind = kindOf(r.token);
        return (
          <tr>
            <th scope="row">
              <span class="fd-token-cell">
                <CopyToken token={r.token} />
                {r.figma ? <span class="fd-figma">Figma: {r.figma}</span> : null}
              </span>
            </th>
            {(['light', 'dark'] as const).map((mode) => (
              <td>
                <span class="fd-value">
                  <span class={`fd-chip fd-chip--${kind} fd-chip--on-${mode}`} style={`--c:${r[mode]}${kind === 'text' && backdrop(r.token, mode) ? `;background-color:${backdrop(r.token, mode)}` : ''}`} aria-hidden="true">
                    {kind === 'text' ? <span>Aa</span> : null}
                  </span>
                  <code class="fd-hex">{r[mode]}</code>
                  {isAlpha(r[mode]) ? <span class="fd-alpha">{Math.round((parseInt(r[mode].slice(7, 9), 16) / 255) * 100)}%</span> : null}
                </span>
              </td>
            ))}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
