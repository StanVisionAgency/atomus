---
// "Copy shadcn add command" + "Open in v0" for one or more items of the Atomus shadcn registry
// (registry/registry.json, served at https://docs.atomus.io/r/<name>.json).
//   <RegistryActions items="button" />              a component page
//   <RegistryActions items={['badge', 'tag']} />    a page with several components
//   <RegistryActions section="Hero section" />      a website section (matched by the item's meta.section)
// Unknown names fail the build, so a page can't point at an item the registry doesn't ship.
import registry from '../../../../registry/registry.json';

interface Props { items?: string | string[]; section?: string; label?: string }
const { items, section, label } = Astro.props;
const REGISTRY = 'https://docs.atomus.io/r';

type Item = { name: string; title?: string; meta?: { section?: string } };
const all = registry.items as Item[];
const names = section
  ? all.filter((i) => i.meta?.section === section).map((i) => i.name)
  : (Array.isArray(items) ? items : items ? [items] : []);
if (!names.length) throw new Error(`RegistryActions: no registry item for ${section ? `section "${section}"` : 'an empty items prop'}`);
const found = names.map((n) => {
  const item = all.find((i) => i.name === n);
  if (!item) throw new Error(`RegistryActions: "${n}" is not in registry/registry.json`);
  return item;
});
const command = `npx shadcn@latest add ${found.map((i) => `${REGISTRY}/${i.name}.json`).join(' ')}`;
const v0 = (name: string) => `https://v0.app/chat/api/open?url=${encodeURIComponent(`${REGISTRY}/${name}.json`)}`;
---
<div class="reg-actions not-content" data-reg-actions>
  <p class="reg-actions__label">{label ?? 'Add the source to a shadcn project'}</p>
  <div class="reg-actions__row">
    <code class="reg-actions__cmd">{command}</code>
    <button type="button" class="at-btn at-btn--secondary at-btn--sm" data-copy={command} aria-label={`Copy shadcn add command for ${found.map((i) => i.title ?? i.name).join(' and ')}`}>
      <span data-copy-label>Copy command</span>
    </button>
    {found.map((i) => (
      <a class="at-btn at-btn--outline at-btn--sm" href={v0(i.name)} target="_blank" rel="noopener noreferrer">
        {found.length > 1 ? `Open ${i.title ?? i.name} in v0` : 'Open in v0'}
      </a>
    ))}
  </div>
  <p class="reg-actions__hint">Installs the component source, its CSS and the Atomus tokens into <code>components/atomus/</code>. <a href="/ai/registry/">How the registry works</a></p>
  <span class="reg-actions__status" role="status" aria-live="polite" data-copy-status></span>
</div>
<style>
  .reg-actions { margin: 1rem 0 1.5rem; padding: var(--spacing-xl); border: 1px solid var(--color-border-secondary); border-radius: var(--radius-xl); background: var(--color-bg-secondary); }
  .reg-actions__label { margin: 0 0 var(--spacing-md); color: var(--color-text-primary); font-size: var(--font-size-small); line-height: var(--line-height-small); font-weight: var(--font-weight-semi-bold); }
  .reg-actions__row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-md); }
  .reg-actions__cmd { flex: 1 1 320px; min-width: 0; padding: var(--spacing-sm) var(--spacing-lg); border: 1px solid var(--color-border-secondary); border-radius: var(--radius-md); background: var(--color-bg-primary); color: var(--color-text-primary); font-family: var(--sl-font-mono); font-size: var(--font-size-tiny); line-height: var(--line-height-tiny); overflow-wrap: anywhere; }
  .reg-actions__hint { margin: var(--spacing-md) 0 0; color: var(--color-text-tertiary); font-size: var(--font-size-tiny); line-height: var(--line-height-tiny); }
  .reg-actions__hint code { font-size: inherit; }
  .reg-actions__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-reg-actions]')) {
    const btn = box.querySelector<HTMLButtonElement>('[data-copy]');
    const label = box.querySelector('[data-copy-label]');
    const status = box.querySelector('[data-copy-status]');
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = 'Command copied to the clipboard';
      } catch {
        if (label) label.textContent = 'Select and copy';
      }
      setTimeout(() => { if (label) label.textContent = 'Copy command'; if (status) status.textContent = ''; }, 2000);
    });
  }
</script>
