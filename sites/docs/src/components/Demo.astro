---
interface Props { caption?: string }
const { caption } = Astro.props;
---
<div class="atomus-demo not-content">
  <div class="atomus-demo__stage"><slot /></div>
  {caption ? <div class="atomus-demo__bar"><span>{caption}</span><span>Live · light and dark follow the theme switch</span></div> : null}
</div>
