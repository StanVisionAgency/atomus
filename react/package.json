{
  "name": "@stanvision/atomus-react",
  "version": "4.1.0",
  "description": "Atomus React components — props mirror the Figma component properties, with Code Connect templates for Figma Dev Mode.",
  "license": "MIT",
  "author": "StanVision (https://stan.vision)",
  "homepage": "https://docs.atomus.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanVisionAgency/atomus.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/StanVisionAgency/atomus/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "figma",
    "ai-agents",
    "tokens",
    "components",
    "code-connect",
    "atomus"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./atomus.css": "./dist/atomus.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.figma.json",
    "prepack": "node -e \"for (const f of ['LICENSE', 'NOTICE']) require('fs').copyFileSync('../' + f, f)\"",
    "figma:check": "node scripts/code-connect-smoke.cjs",
    "figma:publish": "figma connect publish --exit-on-unreadable-files",
    "figma:connect-client": "node scripts/figma-connect-client.mjs",
    "figma:publish:client": "figma connect publish --config figma.client.config.json --exit-on-unreadable-files",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:docs": "storybook build -o ../sites/docs/public/storybook",
    "test-storybook": "node scripts/test-storybook.mjs",
    "test:visual": "playwright test -c tests/playwright.config.ts",
    "test:visual:update": "playwright test -c tests/playwright.config.ts --update-snapshots",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@storybook/test-runner": "^0.26.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "esbuild": "^0.23.0",
    "playwright": "1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.1",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.12"
  }
}
